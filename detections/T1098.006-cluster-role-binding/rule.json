  "variables": {
    "$fxv#0": "// ============================================================================\n// Detection: ClusterRoleBinding / RoleBinding Creation by Non-System Principal\n// MITRE ATT&CK: T1098.006 - Additional Container Cluster Roles\n// Source: AKSAudit\n// ============================================================================\n//\n// Logic: RBAC binding creation outside CI/CD or system controllers is rare and\n// almost always suspicious. In a production cluster you'd add Argo/Flux/Helm\n// controllers to the exclusion list — for the lab, only K8s system controllers\n// are excluded.\n\nAKSAudit\n| where TimeGenerated > ago(1h)\n| where Stage == \"ResponseComplete\"\n| where Verb in (\"create\", \"update\", \"patch\")\n| extend\n    Username     = tostring(User.username),\n    Resource     = tostring(ObjectRef.resource),\n    Namespace    = tostring(ObjectRef.namespace),\n    BindingName  = tostring(ObjectRef.name),\n    ResponseCode = toint(ResponseStatus.code),\n    SourceIp     = tostring(SourceIps[0])\n| where Resource in (\"clusterrolebindings\", \"rolebindings\")\n| where ResponseCode between (200 .. 299)\n// Exclude stable system actors\n| where not(Username startswith \"system:serviceaccount:kube-system:\")\n| where not(Username startswith \"system:node:\")\n| where Username != \"system:kube-controller-manager\"\n| project\n    TimeGenerated, Username, Verb, Resource, BindingName, Namespace,\n    SourceIp, UserAgent\n| extend MitreTechnique = \"T1098.006\"\n"
  },
