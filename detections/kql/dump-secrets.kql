// ============================================================================
// Detection: Cluster-Wide Secret Dump
// MITRE ATT&CK: T1552.007 - Unsecured Credentials: Container API
// Source: AKSAudit
// ============================================================================

// HOW THIS DETECTION WORKS
// -------------------------
// To grab every Secret in the cluster at once, an attacker issues ONE `list`
// against the cluster-scoped path /api/v1/secrets — the API server returns Secrets
// from ALL namespaces in a single response (T1552.007, credentials via the
// container/K8s API).
//
// KEY MODELLING INSIGHT: because it's a single list, "count how many secret reads
// per user" is the WRONG detection model — there's only one call. The tell is the
// cluster-scoped URI itself. Compare:
//   - cluster-wide (this):     /api/v1/secrets
//   - namespaced (normal app): /api/v1/namespaces/<ns>/secrets
//
// TABLE: AKSAudit — the FULL kube audit log including reads (get/list/watch).
//        This must NOT use AKSAuditAdmin, which drops non-mutating reads and so
//        would never see a `list`.

AKSAudit
| where TimeGenerated > ago(1h)                                  // recent window first
| where ObjectRef.resource == "secrets" and Verb == "list"       // only bulk Secret reads
| where RequestUri startswith "/api/v1/secrets"   // cluster-wide, all namespaces
// Tune: controllers (generic-garbage-collector, resourcequota, namespace-controller)
// list secrets cluster-wide as `system:*` — allowlist those, alert on humans/app SAs.
| where User.username != "aksService" and User.username !startswith "system:"  // drop AKS + control-plane
| project TimeGenerated, User = tostring(User.username), ClientIp = tostring(SourceIps[0]), RequestUri  // who + from where + exact path
| extend MitreTechnique = "T1552.007"    // tag with the ATT&CK sub-technique
