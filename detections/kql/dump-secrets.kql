// ============================================================================
// Detection: Cluster-Wide Secret Dump
// MITRE ATT&CK: T1552.007 - Unsecured Credentials: Container API
// Source: AKSAudit
// ============================================================================

// The technique is a SINGLE `list` against /api/v1/secrets (every namespace at
// once) — not a burst of small gets, so counting reads is the wrong model; the
// cluster-scoped URI is the tell. A namespaced read is /api/v1/namespaces/<ns>/secrets.
// NOTE: reads exist only in the full kube-audit table (AKSAudit), not AKSAuditAdmin.
AKSAudit
| where TimeGenerated > ago(1h)
| where ObjectRef.resource == "secrets" and Verb == "list"
| where RequestUri startswith "/api/v1/secrets"   // cluster-wide, all namespaces
// Tune: controllers (generic-garbage-collector, resourcequota, namespace-controller)
// list secrets cluster-wide as `system:*` — allowlist those, alert on humans/app SAs.
| where User.username != "aksService" and User.username !startswith "system:"
| project TimeGenerated, User = tostring(User.username), ClientIp = tostring(SourceIps[0]), RequestUri
| extend MitreTechnique = "T1552.007"
